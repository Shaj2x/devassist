server {
    listen 8080;
    root /usr/share/nginx/html;

    # Rendered from this template at container start (nginx image
    # entrypoint + envsubst). The upstream is resolved at request time, so
    # nginx starts even if the api is still coming up.
    #   docker-compose: NGINX_RESOLVER=127.0.0.11 (Docker's DNS)
    #   Kubernetes:     NGINX_RESOLVER=kube-dns.kube-system.svc.cluster.local
    resolver ${NGINX_RESOLVER} valid=10s ipv6=off;
    set $api_upstream ${API_UPSTREAM};

    location /api/ {
        rewrite ^/api/(.*)$ /$1 break;
        proxy_pass $api_upstream;
        proxy_set_header Host $host;
        proxy_set_header X-Request-ID $request_id;
        # Server-sent events for live job progress.
        proxy_buffering off;
        proxy_read_timeout 1h;
    }

    location /assets/ {
        add_header Cache-Control "public, max-age=31536000, immutable";
    }

    # Client-side routing: unknown paths serve the SPA.
    location / {
        try_files $uri /index.html;
    }
}
