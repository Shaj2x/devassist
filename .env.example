# DevAssist configuration.
# Copy to `.env` (`make up` does this for you) and fill in what you need.
# Every service reads its settings from environment variables; nothing else.

# ---------------------------------------------------------------------------
# General
# ---------------------------------------------------------------------------
# One of: development, test, production. Controls log verbosity defaults.
DEVASSIST_ENV=development
# Log level for every service: DEBUG, INFO, WARNING, ERROR.
LOG_LEVEL=INFO

# ---------------------------------------------------------------------------
# PostgreSQL (with pgvector)
# ---------------------------------------------------------------------------
POSTGRES_USER=devassist
POSTGRES_PASSWORD=devassist
POSTGRES_DB=devassist
# Host port the database is published on (inside the compose network it is always 5432).
POSTGRES_PORT=5432
# Connection string used by services. Python services convert the scheme as needed.
# Inside docker-compose the host is `postgres`; from your machine use `localhost`.
DATABASE_URL=postgresql://devassist:devassist@localhost:5432/devassist

# ---------------------------------------------------------------------------
# Redis
# ---------------------------------------------------------------------------
REDIS_PORT=6379
REDIS_URL=redis://localhost:6379/0

# ---------------------------------------------------------------------------
# Kafka (KRaft mode, single node for local dev)
# ---------------------------------------------------------------------------
# Inside compose services use kafka:9092; from your machine use localhost:29092.
KAFKA_BOOTSTRAP_SERVERS=localhost:29092
# Prefix for consumer group ids, e.g. devassist-orchestrator.
KAFKA_CONSUMER_GROUP_PREFIX=devassist

# ---------------------------------------------------------------------------
# Service ports (host side)
# ---------------------------------------------------------------------------
API_PORT=8000
ORCHESTRATOR_PORT=8001
INDEXER_PORT=8080
SANDBOX_RUNNER_PORT=8081
DASHBOARD_PORT=3000

# Internal URLs services use to reach each other.
INDEXER_URL=http://localhost:8080

# ---------------------------------------------------------------------------
# LLM providers (used from Phase 2 / Phase 4 onward)
# ---------------------------------------------------------------------------
# Chat/completions provider for the agents: anthropic | openai | mock
LLM_PROVIDER=mock
LLM_MODEL=
ANTHROPIC_API_KEY=
OPENAI_API_KEY=
# Hard per-call timeout and retry budget for every LLM request.
LLM_TIMEOUT_SECONDS=120
LLM_MAX_RETRIES=3

# Embedding provider for the indexer: openai | voyage | local
# `local` is a deterministic hashing embedder: no API key, lower quality,
# good enough to run the whole demo offline.
EMBEDDING_PROVIDER=local
EMBEDDING_MODEL=
EMBEDDING_DIMENSIONS=1024
VOYAGE_API_KEY=

# ---------------------------------------------------------------------------
# GitHub (used from Phase 5 onward)
# ---------------------------------------------------------------------------
# A fine-grained personal access token with contents + pull requests write
# access to the repos you want DevAssist to work on.
GITHUB_TOKEN=
# Optional OAuth app credentials (alternative to a PAT).
GITHUB_OAUTH_CLIENT_ID=
GITHUB_OAUTH_CLIENT_SECRET=
# Key used to encrypt stored GitHub tokens at rest (32 url-safe base64 bytes).
# Generate with: python -c "import base64,os;print(base64.urlsafe_b64encode(os.urandom(32)).decode())"
TOKEN_ENCRYPTION_KEY=
