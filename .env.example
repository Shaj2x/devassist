# DevAssist configuration.
# Copy to `.env` (`make up` does this for you) and fill in what you need.
# Every service reads its settings from environment variables; nothing else.

# ---------------------------------------------------------------------------
# General
# ---------------------------------------------------------------------------
# One of: development, test, production. Controls log verbosity defaults.
DEVASSIST_ENV=development
# Log level for every service: DEBUG, INFO, WARNING, ERROR.
LOG_LEVEL=INFO

# ---------------------------------------------------------------------------
# PostgreSQL (with pgvector)
# ---------------------------------------------------------------------------
POSTGRES_USER=devassist
POSTGRES_PASSWORD=devassist
POSTGRES_DB=devassist
# Host port the database is published on (inside the compose network it is always 5432).
POSTGRES_PORT=5432
# Connection string used by services. Python services convert the scheme as needed.
# Inside docker-compose the host is `postgres`; from your machine use `localhost`.
DATABASE_URL=postgresql://devassist:devassist@localhost:5432/devassist

# ---------------------------------------------------------------------------
# Redis
# ---------------------------------------------------------------------------
REDIS_PORT=6379
REDIS_URL=redis://localhost:6379/0

# ---------------------------------------------------------------------------
# Kafka (KRaft mode, single node for local dev)
# ---------------------------------------------------------------------------
# Inside compose services use kafka:9092; from your machine use localhost:29092.
KAFKA_BOOTSTRAP_SERVERS=localhost:29092
# Prefix for consumer group ids, e.g. devassist-orchestrator.
KAFKA_CONSUMER_GROUP_PREFIX=devassist

# ---------------------------------------------------------------------------
# Service ports (host side)
# ---------------------------------------------------------------------------
API_PORT=8000
ORCHESTRATOR_PORT=8001
INDEXER_PORT=8080
SANDBOX_RUNNER_PORT=8081
DASHBOARD_PORT=3000

# Internal URLs services use to reach each other.
INDEXER_URL=http://localhost:8080

# ---------------------------------------------------------------------------
# LLM providers (used from Phase 2 / Phase 4 onward)
# ---------------------------------------------------------------------------
# Provider for the agents: anthropic | openai | mock
LLM_PROVIDER=mock
# Empty = provider default (anthropic: claude-opus-5-5, openai: gpt-5).
LLM_MODEL=
ANTHROPIC_API_KEY=
OPENAI_API_KEY=
# Per-attempt timeout and retry count for every LLM request (the SDKs back
# off exponentially on 429, 5xx and connection errors).
LLM_TIMEOUT_SECONDS=180
LLM_MAX_RETRIES=3
# Anthropic: on a safety refusal, let the API retry on a fallback model.
LLM_REFUSAL_FALLBACK=true
# Mock provider: a script in services/orchestrator/.../mock_scripts or a path.
LLM_MOCK_SCRIPT=datekit_fix_leap_year
# Prices for models not in llm/pricing.py (USD per million tokens).
LLM_PRICE_INPUT_PER_MTOK=
LLM_PRICE_OUTPUT_PER_MTOK=

# Agent loop limits.
MAX_ITERATIONS=3
JOB_BUDGET_USD=2.0
# Jobs one orchestrator replica runs at once.
ORCHESTRATOR_CONCURRENCY=2

# Embedding provider for the indexer: local | openai | voyage
# `local` is a deterministic hashing embedder: no API key, lexical rather than
# semantic matching, good enough to run the whole demo offline.
EMBEDDING_PROVIDER=local
# Empty = provider default (openai: text-embedding-3-small, voyage: voyage-code-3).
EMBEDDING_MODEL=
# Must match the vector(1024) column; changing it requires a migration.
EMBEDDING_DIMENSIONS=1024
VOYAGE_API_KEY=
# Texts per embedding request, parallel requests, and a shared request budget.
EMBEDDING_BATCH_SIZE=64
EMBEDDING_CONCURRENCY=4
EMBEDDING_REQUESTS_PER_MINUTE=300
EMBEDDING_TIMEOUT=60s
EMBEDDING_MAX_RETRIES=4

# ---------------------------------------------------------------------------
# Indexer
# ---------------------------------------------------------------------------
# Files larger than this are skipped (bytes).
INDEXER_MAX_FILE_BYTES=262144
# Parallel tree-sitter workers (default: number of CPUs).
INDEXER_CHUNK_WORKERS=
# Redis lock lease per repository while indexing; renewed automatically.
INDEX_LOCK_TTL=2m
SEARCH_CACHE_TTL=10m

# ---------------------------------------------------------------------------
# Sandbox runner
# ---------------------------------------------------------------------------
# Per-sandbox limits. Memory and tmpfs accept k/m/g suffixes.
SANDBOX_MEMORY=1g
SANDBOX_CPUS=1
SANDBOX_PIDS=256
SANDBOX_TMPFS_SIZE=1g
# Whole validation, and each individual command.
SANDBOX_TIMEOUT=5m
SANDBOX_STEP_TIMEOUT=3m
# Sandboxes one runner may run at once.
SANDBOX_CONCURRENCY=2
# Group id owning /var/run/docker.sock on the host; `make up` fills it in.
DOCKER_GID=
# Allow network during dependency install only (disconnected before any
# patched code runs). false = no network at any point.
SANDBOX_INSTALL_NETWORK=true

# ---------------------------------------------------------------------------
# API auth and GitHub
# ---------------------------------------------------------------------------
# dev:   no sign-in; everything runs as a local "demo" user and GitHub calls
#        use GITHUB_TOKEN. Only for your own machine.
# token: users sign in with their own GitHub token (stored encrypted) and get
#        an opaque session token. Use this for anything others can reach.
AUTH_MODE=dev
# Dev mode: a fine-grained personal access token with Contents and Pull
# requests write access to the repos DevAssist should open PRs on. Empty =
# public repos only, and approving a GitHub job will ask for a token.
GITHUB_TOKEN=
# GitHub Enterprise: https://ghe.example.com/api/v3
GITHUB_API_URL=https://api.github.com
# Allow registering non-GitHub clone URLs (file://...). Empty = on in dev mode,
# off in token mode.
ALLOW_LOCAL_REPOS=
# Required in token mode: key used to encrypt stored GitHub tokens at rest (32 url-safe base64 bytes).
# Generate with: python -c "import base64,os;print(base64.urlsafe_b64encode(os.urandom(32)).decode())"
TOKEN_ENCRYPTION_KEY=
